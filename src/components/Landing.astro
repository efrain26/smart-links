---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/site";
import {
  defaultLocale,
  languages,
  locales,
  useTranslations,
  type Locale,
} from "@/i18n/ui";
import EmailForm from "@/components/ui/EmailForm.astro";

const currentLocale = (Astro.currentLocale ?? defaultLocale) as Locale;
const t = useTranslations(currentLocale);
---

<header
  class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur"
>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <a
      href={getRelativeLocaleUrl(defaultLocale)}
      class="text-lg font-bold tracking-tight"
    >
      {siteConfig.name}
    </a>
    <div class="flex items-center gap-3">
      <nav
        class="hidden items-center gap-6 text-sm text-muted-foreground sm:flex"
      >
        <a href="#como-funciona" class="hover:text-foreground"
          >{t.nav.howItWorks}</a
        >
        <a href="#diferenciadores" class="hover:text-foreground"
          >{t.nav.differentiators}</a
        >
        <a href="#faq" class="hover:text-foreground">{t.nav.faq}</a>
        <a
          href="#cta-final"
          class="rounded-xl bg-foreground px-4 py-2 font-bold text-background hover:bg-foreground/90"
        >
          {t.nav.cta}
        </a>
      </nav>
      <details
        class="group relative"
        data-language-switcher
        aria-label={t.selectLanguage}
      >
        <summary
          class="flex cursor-pointer list-none items-center gap-2 rounded-xl border border-border bg-background/60 px-3 py-2 text-sm font-semibold text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground [&::-webkit-details-marker]:hidden"
        >
          <Icon name="lucide:globe" class="size-4" />
          {languages[currentLocale]}
          <Icon
            name="lucide:chevron-down"
            class="size-3.5 text-muted-foreground/70 transition-transform duration-200 group-open:rotate-180"
          />
        </summary>
        <div
          class="absolute right-0 top-full z-50 mt-2 min-w-44 rounded-xl border border-border bg-background p-1.5 shadow-xl shadow-primary/5"
        >
          {
            locales.map((locale) => (
              <a
                href={getRelativeLocaleUrl(locale)}
                class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                aria-current={locale === currentLocale ? "page" : undefined}
              >
                <span>{languages[locale]}</span>
                {locale === currentLocale && (
                  <Icon name="lucide:check" class="size-4 text-primary" />
                )}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </div>
</header>

<section id="hero" class="relative overflow-hidden">
  <div class="pointer-events-none absolute inset-0">
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(2,84,216,0.12)_0%,transparent_55%)]"
    >
    </div>
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,rgba(168,85,247,0.10)_0%,transparent_55%)]"
    >
    </div>
  </div>
  <div
    class="relative mx-auto flex min-h-[80vh] max-w-3xl flex-col items-center justify-center px-6 py-24 text-center"
  >
    <p
      class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-muted/60 px-4 py-1.5 text-sm text-muted-foreground"
    >
      {t.badge}
    </p>
    <h1
      class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl"
    >
      {t.headline}{" "}
      <span
        class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent"
      >
        {t.headlineHighlight}
      </span>
    </h1>
    <p
      class="mt-6 max-w-2xl text-pretty text-lg text-muted-foreground sm:text-xl"
    >
      {t.subheadline}
    </p>
    <div class="mt-10 w-full max-w-xl">
      <EmailForm
        id="hero-form"
        emailLabel={t.form.emailLabel}
        emailPlaceholder={t.form.emailPlaceholder}
        invalidEmail={t.form.invalidEmail}
        successMessage={t.form.successMessage}
      />
      <p class="mt-3 text-sm text-muted-foreground">{t.form.privacyNote}</p>
    </div>
  </div>
</section>

<section id="dolor" class="border-t border-border bg-muted/40 px-6 py-20">
  <div class="mx-auto max-w-3xl">
    <p class="text-sm font-semibold uppercase tracking-wide text-primary">
      {t.pain.eyebrow}
    </p>
    <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
      {t.pain.title}
    </h2>
    <p class="mt-4 text-lg text-muted-foreground">{t.pain.body}</p>
  </div>
</section>

<section id="como-funciona" class="px-6 py-20">
  <div class="mx-auto max-w-5xl">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.howItWorks.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.howItWorks.title}
      </h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.howItWorks.steps.map((step, i) => (
          <div class="rounded-2xl border border-border bg-card p-6">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-lg font-bold text-primary">
              {i + 1}
            </span>
            <h3 class="mt-4 text-xl font-bold">{step.title}</h3>
            <p class="mt-2 text-muted-foreground">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section
  id="diferenciadores"
  class="border-t border-border bg-muted/40 px-6 py-20"
>
  <div class="mx-auto max-w-5xl">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.differentiators.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.differentiators.title}
      </h2>
    </div>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        t.differentiators.items.map((item) => (
          <div class="rounded-2xl border border-border bg-card p-6">
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary">
              {item.icon}
            </span>
            <h3 class="mt-4 text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-muted-foreground">{item.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section id="soporte" class="px-6 py-20">
  <div class="mx-auto max-w-3xl text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {t.support.title}
    </h2>
    <p class="mt-4 text-lg text-muted-foreground">{t.support.body}</p>
  </div>
</section>

<section id="faq" class="border-t border-border bg-muted/40 px-6 py-20">
  <div class="mx-auto max-w-3xl">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">
        {t.faq.eyebrow}
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        {t.faq.title}
      </h2>
    </div>
    <div class="mt-10 space-y-4">
      {
        t.faq.items.map((faq) => (
          <details class="group rounded-2xl border border-border bg-card">
            <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-bold">
              {faq.question}
              <span class="text-muted-foreground transition-transform group-open:rotate-45">
                +
              </span>
            </summary>
            <p class="px-5 pb-5 text-muted-foreground">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section id="cta-final" class="px-6 py-24">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {t.ctaFinal.title}
    </h2>
    <p class="mt-4 text-lg text-muted-foreground">{t.ctaFinal.body}</p>
    <div class="mt-8 w-full max-w-xl mx-auto">
      <EmailForm
        id="cta-form"
        buttonText={t.form.ctaFinal}
        emailLabel={t.form.emailLabel}
        emailPlaceholder={t.form.emailPlaceholder}
        invalidEmail={t.form.invalidEmail}
        successMessage={t.form.successMessage}
      />
    </div>
  </div>
</section>

<footer class="border-t border-border px-6 py-8">
  <div
    class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 text-sm text-muted-foreground sm:flex-row"
  >
    <p>© {new Date().getFullYear()} {siteConfig.name}</p>
    <p>{t.footer.privacyContact}</p>
  </div>
</footer>

<script>
  const switchers = document.querySelectorAll<HTMLDetailsElement>(
    "[data-language-switcher]",
  );

  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    switchers.forEach((details) => {
      if (details.open && !details.contains(target)) {
        details.open = false;
      }
    });
  });
</script>
