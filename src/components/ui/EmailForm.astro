---
import { siteConfig } from "@/config/site";
import { useTranslations } from "@/i18n/ui";
import Button from "./Button.astro";

interface Props {
  id: string;
  buttonText?: string;
  successMessage?: string;
  emailLabel?: string;
  emailPlaceholder?: string;
  invalidEmail?: string;
}

const t = useTranslations(Astro.currentLocale);

const {
  id,
  buttonText = t.form.cta,
  successMessage = t.form.successMessage,
  emailLabel = t.form.emailLabel,
  emailPlaceholder = t.form.emailPlaceholder,
  invalidEmail = t.form.invalidEmail,
} = Astro.props;
---

<form
  id={id}
  action={siteConfig.capture.endpoint}
  method="post"
  target={`${id}-frame`}
  class="flex w-full flex-col gap-3 sm:flex-row"
  data-email-form
  data-success={successMessage}
  data-invalid={invalidEmail}
  data-survey-url={siteConfig.capture.surveyUrl}
>
  <input type="hidden" name="embed" value="1" />
  <label for={`${id}-email`} class="sr-only">{emailLabel}</label>
  <input
    id={`${id}-email`}
    type="email"
    name="email"
    required
    autocomplete="email"
    placeholder={emailPlaceholder}
    class="w-full flex-1 rounded-xl border-border bg-muted/50 px-4 py-3 text-foreground placeholder:text-muted-foreground focus:border-primary focus:ring-primary/20 transition-all border outline-none focus:ring-4"
  />
  <Button type="submit" size="lg" class="w-full shrink-0 sm:w-auto">
    {buttonText}
  </Button>
</form>
<iframe id={`${id}-frame`} name={`${id}-frame`} class="hidden" tabindex="-1"
></iframe>
<p id={`${id}-status`} class="sr-only" role="status" aria-live="polite"></p>

<script>
  import { track } from "@vercel/analytics";

  const forms = document.querySelectorAll<HTMLFormElement>(
    "form[data-email-form]",
  );

  forms.forEach((form) => {
    const id = form.id;
    const status = document.getElementById(
      `${id}-status`,
    ) as HTMLParagraphElement | null;
    const button = form.querySelector(
      "button[type=submit]",
    ) as HTMLButtonElement | null;

    const successMessage = form.dataset.success ?? "";
    const invalidMessage = form.dataset.invalid ?? "Invalid email.";
    const surveyUrl = form.dataset.surveyUrl ?? "";

    button?.addEventListener("click", () => {
      track("cta_click", { form: id });
    });

    form.addEventListener("submit", (event) => {
      const input = form.querySelector<HTMLInputElement>('input[name="email"]');
      const email = input?.value ?? "";

      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        event.preventDefault();
        status?.classList.remove("sr-only");
        if (status) status.textContent = invalidMessage;
        return;
      }

      track("form_submit", { form: id });

      status?.classList.remove("sr-only");
      if (status) status.textContent = successMessage;

      if (surveyUrl) {
        const separator = surveyUrl.includes("?") ? "&" : "?";
        const target = `${surveyUrl}${separator}email=${encodeURIComponent(email)}`;
        window.setTimeout(() => {
          window.location.assign(target);
        }, 1000);
      }
    });
  });
</script>
