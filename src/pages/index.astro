---
import LandingLayout from "@/layouts/LandingLayout.astro";
import { siteConfig } from "@/config/site";
import EmailForm from "@/components/ui/EmailForm.astro";

const metadata = {
  title: `${siteConfig.name} — Enlace inteligente para iOS y Android, sin SDK`,
  description:
    "Crea un enlace que abre tu app en iPhone o Android según el dispositivo del visitante. Sin SDK, listo en minutos.",
};

const steps = [
  {
    title: "Crea tu enlace",
    description:
      "Pega el link de tu app en iOS y Android. Tu enlace inteligente queda listo en minutos, sin tocar código.",
  },
  {
    title: "Pégalo en tu campaña",
    description:
      "Úsalo en tus emails, SMS, ads o en la bio de tu herramienta de marketing. Un solo link para todo.",
  },
  {
    title: "Detectamos y redirigimos",
    description:
      "Según el dispositivo del visitante, lo mandamos a tu app o a la tienda correcta (App Store o Play Store).",
  },
];

const differentiators = [
  {
    title: "Sin SDK",
    description:
      "Sin integrar código en tu app ni depender de un desarrollador. Lo configuras tú.",
    icon: "✓",
  },
  {
    title: "Precio accesible",
    description:
      "Sin mensualidades de cientos de dólares ni costos de plataformas enterprise. Pagas solo por lo que usas.",
    icon: "✓",
  },
  {
    title: "Hecho para marketers",
    description:
      "Pensado para tus campañas de email, SMS y ads, sin depender de un desarrollador.",
    icon: "✓",
  },
];

const faqs = [
  {
    question: "¿Necesito un SDK?",
    answer:
      "No. En esta fase no se integra ningún SDK ni se depende de un desarrollador: el enlace hace el trabajo por ti.",
  },
  {
    question: "¿En qué se diferencia de otras soluciones de enlaces?",
    answer:
      "Es una opción simple y barata, self-serve y sin SDK, sin mensualidades de cientos de dólares.",
  },
  {
    question: "¿Cuánto cuesta?",
    answer:
      "Estamos cerrando el precio y lo probamos contigo antes de lanzar. Regístrate y te notificamos cuando esté disponible.",
  },
  {
    question: "¿Soporta mi herramienta de email o SMS?",
    answer:
      "Sí. Si pegas un link, funciona: emails, SMS y ads en tus campañas.",
  },
];
---

<LandingLayout title={metadata.title} description={metadata.description}>
  <header
    class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur"
  >
    <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
      <a href="/" class="text-lg font-bold tracking-tight">
        {siteConfig.name}
      </a>
      <nav
        class="hidden items-center gap-6 text-sm text-muted-foreground sm:flex"
      >
        <a href="#como-funciona" class="hover:text-foreground">Cómo funciona</a>
        <a href="#diferenciadores" class="hover:text-foreground"
          >Diferenciadores</a
        >
        <a href="#faq" class="hover:text-foreground">Preguntas</a>
        <a
          href="#cta-final"
          class="rounded-xl bg-foreground px-4 py-2 font-bold text-background hover:bg-foreground/90"
        >
          Quiero mi enlace
        </a>
      </nav>
    </div>
  </header>

  <section id="hero" class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(2,84,216,0.12)_0%,transparent_55%)]"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_bottom_right,rgba(168,85,247,0.10)_0%,transparent_55%)]"
      >
      </div>
    </div>
    <div
      class="relative mx-auto flex min-h-[80vh] max-w-3xl flex-col items-center justify-center px-6 py-24 text-center"
    >
      <p
        class="mb-6 inline-flex items-center gap-2 rounded-full border border-border bg-muted/60 px-4 py-1.5 text-sm text-muted-foreground"
      >
        Sin SDK · Listo en minutos · Para marketers
      </p>
      <h1
        class="text-balance text-3xl font-extrabold tracking-tight sm:text-4xl md:text-5xl"
      >
        {siteConfig.headline}{" "}
        <span
          class="bg-linear-to-r from-blue-400 via-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          {siteConfig.headlineHighlight}
        </span>
      </h1>
      <p
        class="mt-6 max-w-2xl text-pretty text-lg text-muted-foreground sm:text-xl"
      >
        {siteConfig.subheadline}
      </p>
      <div class="mt-10 w-full max-w-xl">
        <EmailForm id="hero-form" />
        <p class="mt-3 text-sm text-muted-foreground">
          Sin spam. Solo lo necesario para avisarte.
        </p>
      </div>
    </div>
  </section>

  <section id="dolor" class="border-t border-border bg-muted/40 px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary">
        ¿Te suena esto?
      </p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
        Tu campaña funciona, pero el link no abre la app
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Mandas un email o un SMS con un link a tu app… y el visitante cae en el
        navegador en vez de abrirla. En móvil, cada paso extra es un usuario
        perdido.
      </p>
    </div>
  </section>

  <section id="como-funciona" class="px-6 py-20">
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">
          Cómo funciona
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Listo en minutos, en 3 pasos
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          steps.map((step, i) => (
            <div class="rounded-2xl border border-border bg-card p-6">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-lg font-bold text-primary">
                {i + 1}
              </span>
              <h3 class="mt-4 text-xl font-bold">{step.title}</h3>
              <p class="mt-2 text-muted-foreground">{step.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section
    id="diferenciadores"
    class="border-t border-border bg-muted/40 px-6 py-20"
  >
    <div class="mx-auto max-w-5xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">
          ¿Por qué nosotros?
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Sin lo que hace caras a otras soluciones
        </h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {
          differentiators.map((item) => (
            <div class="rounded-2xl border border-border bg-card p-6">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-primary/10 text-primary">
                {item.icon}
              </span>
              <h3 class="mt-4 text-xl font-bold">{item.title}</h3>
              <p class="mt-2 text-muted-foreground">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="soporte" class="px-6 py-20">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        ¿Buscas alternativa a algo que dejó de funcionar?
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        ¿Tu solución de enlaces se apagó o cuesta demasiado? Si tu negocio
        depende de links que abran tu app, tienes que resolverlo hoy con una
        opción simple y barata.
      </p>
    </div>
  </section>

  <section id="faq" class="border-t border-border bg-muted/40 px-6 py-20">
    <div class="mx-auto max-w-3xl">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-primary">
          Preguntas frecuentes
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          Respuestas cortas
        </h2>
      </div>
      <div class="mt-10 space-y-4">
        {
          faqs.map((faq) => (
            <details class="group rounded-2xl border border-border bg-card">
              <summary class="flex cursor-pointer items-center justify-between gap-4 p-5 font-bold">
                {faq.question}
                <span class="text-muted-foreground transition-transform group-open:rotate-45">
                  +
                </span>
              </summary>
              <p class="px-5 pb-5 text-muted-foreground">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section id="cta-final" class="px-6 py-24">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
        Notifícame cuando salga
      </h2>
      <p class="mt-4 text-lg text-muted-foreground">
        Sin spam. Una notificación cuando esté listo y tu enlace pueda
        funcionar.
      </p>
      <div class="mt-8 w-full max-w-xl mx-auto">
        <EmailForm id="cta-form" buttonText={siteConfig.ctaFinal} />
      </div>
    </div>
  </section>

  <footer class="border-t border-border px-6 py-8">
    <div
      class="mx-auto flex max-w-5xl flex-col items-center justify-between gap-3 text-sm text-muted-foreground sm:flex-row"
    >
      <p>© {new Date().getFullYear()} {siteConfig.name}</p>
      <p>Privacidad · Contacto</p>
    </div>
  </footer>
</LandingLayout>
